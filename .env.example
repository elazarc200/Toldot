# -----------------------------------------------------------------------------
# Toladot — environment placeholders (NO real secrets)
# Copy to .env.local. Never commit real values.
# -----------------------------------------------------------------------------

# --- Environment identity ---
# local | pilot | production (production = future public launch only)
TOLADOT_ENV=local
NEXT_PUBLIC_TOLADOT_ENV=local

# Absolute site origin (required on Pilot/Production for sitemap/canonicals)
# NEXT_PUBLIC_SITE_URL=https://your-pilot.example.com

# =============================================================================
# WEB PUBLIC (safe in browser / NEXT_PUBLIC_*)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
NEXT_PUBLIC_APP_NAME=תולדות

# =============================================================================
# RUNTIME SERVER (Next.js server only — never NEXT_PUBLIC_*)
# =============================================================================
# LOG_LEVEL=info
# Optional Pilot daily AI cost safety stop (USD). Worker/web may enforce.
# AI_DAILY_COST_CEILING_USD=25

# =============================================================================
# RUNTIME WORKER (Fly.io / local ai-worker — NEVER service-role)
# =============================================================================
# AI_WORKER_EMAIL=ai-worker@example.com
# AI_WORKER_PASSWORD=use-a-strong-nonprod-password
# AI_WORKER_SECRET=generate-a-long-random-secret-min-24-chars
# AI_LLM_PROVIDER=fake
# OPENAI_API_KEY=sk-...   # required when AI_LLM_PROVIDER=openai (Pilot)
# AI_OPENAI_MODEL_MID=gpt-4o-mini
# AI_OPENAI_MODEL_HIGH=gpt-4o
# AI_WORKER_POLL_MS=2000

# =============================================================================
# BOOTSTRAP ADMIN (operator machine ONLY — never web, never worker runtime)
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# BOOTSTRAP_EDITOR_USER_ID=00000000-0000-0000-0000-000000000000
# BOOTSTRAP_EDITOR_EMAIL=editor@example.com
# Used by: npm run bootstrap:editor | npm run bootstrap:ai-worker

# =============================================================================
# RLS / integration tests (gitignored .env.local only)
# =============================================================================
# RLS_TEST_EDITOR_EMAIL=editor@example.com
# RLS_TEST_EDITOR_PASSWORD=use-a-strong-nonprod-password
# RLS_TEST_NON_EDITOR_EMAIL=reader@example.com
# RLS_TEST_NON_EDITOR_PASSWORD=use-a-strong-nonprod-password
# RLS_TEST_AI_WORKER_EMAIL=ai-worker@example.com
# RLS_TEST_AI_WORKER_PASSWORD=use-a-strong-nonprod-password
# RLS_TEST_AI_WORKER_SECRET=same-as-bootstrapped-worker-secret
